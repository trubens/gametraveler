# Filer med hash i navnet (assets/) endres aldri og kan caches i et år.
# Alt annet, særlig HTML og app.js/app.css som peker på dem, sjekkes mot serveren hver gang,
# så en ny publisering vises med en gang.
<IfModule mod_headers.c>
  Header set Cache-Control "no-cache"
  <If "%{REQUEST_URI} =~ m#/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# Egen feilside (laget av scripts/prerender.mjs) med lenke tilbake til kartet og et søkefelt
ErrorDocument 404 /gametraveler/404.html

# Filer og mapper som begynner med punktum (publiseringsmanifestet, .htaccess) er ikke for publikum.
# 404 i stedet for 403, så det ikke røper at de finnes; .well-known (sertifikater o.l.) slippes gjennom.
RedirectMatch 404 "/[.](?!well-known(?:/|$))"

AddType application/manifest+json .webmanifest

<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml
  </IfModule>
</IfModule>
