# Public site URL without a trailing slash, used for canonical links, Open Graph tags and the sitemap.
# Example: VITE_SITE_URL=https://gametraveller.example
VITE_SITE_URL=

# Where "Suggest a game" should link (a GitHub issue template, a form, …). The link is hidden when empty.
# Example: VITE_CONTRIBUTE_URL=https://github.com/you/game-traveller/issues/new?template=game.yml
VITE_CONTRIBUTE_URL=
