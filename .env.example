# Public URL without a trailing slash. Used for canonical links, Open Graph tags and sitemap.
VITE_SITE_URL=https://example.org/gametraveler

# Optional URL for the "Suggest a game" link.
VITE_CONTRIBUTE_URL=

# AdSense unit for production only. Local builds show a placeholder and never load ads.
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_DETAIL_SLOT_ID=

# Optional IGDB cover-fetch credentials. Never commit real values.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
